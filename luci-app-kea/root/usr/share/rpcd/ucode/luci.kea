'use strict';

import { cursor } from 'uci';
import * as config from 'luci.kea.config';
import * as service from 'luci.kea.service';
import * as importer from 'luci.kea.importer';
import * as runtime from 'luci.kea.runtime';
import * as setup from 'luci.kea.setup';

// rpcd plugin for luci-app-kea. The work is done by the luci.kea.* modules;
// this file only maps ubus methods to them. Method names and reply shapes
// are what the LuCI views expect and must stay stable.

const ctx = config.context();

function dhcp_hosts() {
	let hosts = [];

	cursor(ctx.uci_dir, ctx.uci_savedir).foreach('dhcp', 'host', s => push(hosts, s));

	return hosts;
}

const methods = {
	getStatus: {
		call: function() {
			return { status: service.status(ctx) };
		}
	},

	getServices: {
		call: function() {
			return { services: service.services(ctx) };
		}
	},

	getDaemonState: {
		call: function() {
			return { daemons: service.daemon_states(ctx) };
		}
	},

	getNetworkInterfaces: {
		call: function() {
			return { interfaces: { items: service.network_interfaces(ctx) } };
		}
	},

	getLeases: {
		call: function() {
			return { leases: importer.mark_reserved(ctx, runtime.leases(ctx)) };
		}
	},

	getLog: {
		args: { lines: 30 },
		call: function(request) {
			return runtime.log(ctx, request.args.lines);
		}
	},

	validate: {
		call: function() {
			return { validation: config.validate_all(ctx) };
		}
	},

	getConfigList: {
		call: function() {
			return { configs: { items: config.list(ctx) } };
		}
	},

	// For every user with read access: the file with its secrets masked.
	getConfig: {
		args: { name: 'name' },
		call: function(request) {
			return config.read_masked(ctx, request.args.name);
		}
	},

	// For a user who may change the file: the file as it is.
	getConfigRaw: {
		args: { name: 'name' },
		call: function(request) {
			return config.read(ctx, request.args.name);
		}
	},

	saveConfig: {
		args: { name: 'name', content: 'content' },
		call: function(request) {
			return config.save(ctx, request.args.name, request.args.content);
		}
	},

	listBackups: {
		args: { name: 'name' },
		call: function(request) {
			return config.list_backups(ctx, request.args.name);
		}
	},

	restoreBackup: {
		args: { name: 'name', id: 'id' },
		call: function(request) {
			return config.restore(ctx, request.args.name, request.args.id);
		}
	},

	importDnsmasqDryRun: {
		call: function() {
			return { import: importer.preview(ctx, dhcp_hosts(), service.network_interfaces(ctx)) };
		}
	},

	reserveLease: {
		args: { family: 'family', identifier: 'identifier', address: 'address', hostname: 'hostname' },
		call: function(request) {
			return importer.reserve(ctx, service.network_interfaces(ctx), request.args);
		}
	},

	// The Setup page: what the configuration made from dnsmasq's settings
	// would be, and writing it where the file is still the sample, or, with
	// "replace" after the user confirmed it, over a file of their own. The
	// page passes the reply of "ha-cluster nodes" it got itself.
	setupFromDnsmasq: {
		args: { dry_run: true, replace: false, cluster: {} },
		call: function(request) {
			return setup.run(ctx, service.setup_input(ctx, request.args.cluster),
				{ dry_run: request.args.dry_run !== false, replace: request.args.replace === true });
		}
	},

	// Hand the leases of dnsmasq to a running kea-dhcp4.
	moveDnsmasqLeases: {
		call: function() {
			let leases = importer.read_lease_file(service.dnsmasq_lease_file(ctx));

			if (leases.error)
				return { result: false, reason: leases.error, added: 0, skipped: [] };

			return importer.move_leases(ctx, leases.content ?? '', time());
		}
	},

	importDnsmasqCommit: {
		args: { entries: [] },
		call: function(request) {
			return importer.commit(ctx, dhcp_hosts(), service.network_interfaces(ctx),
				request.args.entries);
		}
	},

	setService: {
		args: { name: 'name', enabled: true },
		call: function(request) {
			return service.set_service(ctx, request.args.name, request.args.enabled);
		}
	},

	setInitAction: {
		args: { action: 'action' },
		call: function(request) {
			return service.init_action(ctx, request.args.action);
		}
	},

	setConflictAction: {
		args: { name: 'name', action: 'action' },
		call: function(request) {
			return service.conflict_action(ctx, request.args.name, request.args.action);
		}
	}
};

return { 'luci.kea': methods };
