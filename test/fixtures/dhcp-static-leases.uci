config host 'dual'
	option name 'laptop'
	list mac '02:00:00:00:00:AA'
	option ip '192.168.1.77'
	list duid '00030001020000000aaa'
	option hostid '77'

config host 'printer'
	option name 'printer'
	list mac '02:00:00:00:00:ab'
	option ip '192.168.1.78'
	option leasetime '12h'

config host 'known'
	option name 'nas'
	list mac '02:00:00:00:00:01'
	option ip '192.168.1.10'

config host 'docked'
	option name 'dock'
	list mac '02:00:00:00:00:b1'
	list mac '02:00:00:00:00:b2'
	option ip '192.168.1.90'

config host 'elsewhere'
	option name 'far'
	list mac '02:00:00:00:00:c1'
	option ip '172.16.9.9'

config host 'off'
	option name 'spare'
	list mac '02:00:00:00:00:d1'
	option ip '192.168.1.91'
	option enable '0'

config host 'truncated'
	option name 'bad-v6'
	list duid '00'
	option hostid '99'

config host 'byname'
	option name 'only-name'
	option ip '192.168.1.92'
